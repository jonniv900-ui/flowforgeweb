        {
          "id": "91509767-a6ca-4458-9835-07163f3d75bb",
          "kind": "chart",
          "name": "gfVendas",
          "text": "",
          "x": 20,
          "y": 172,
          "width": "350px",
          "height": "250px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "select": "// event.detail = { index, label, value, series }\nlblInfo.textContent = event.detail.label + ': R$ ' + event.detail.value.toLocaleString('pt-BR');\n"
          },
          "chartType": "bar",
          "chartTitle": "Vendas por mês",
          "chartLabels": "Jan,Fev,Mar,Abr,Mai,Jun",
          "values": "[1200,1850,950,2100,1700,2400]",
          "chartSeries": "Vendas",
          "valuePrefix": "R$ ",
          "legend": true,
          "showValues": true,
          "chartGrid": true,
          "animate": true
        },
        {
          "id": "65200e6b-45b6-4fd3-8c42-739be75b43f3",
          "kind": "select",
          "name": "selTipo",
          "text": "",
          "x": 20,
          "y": 432,
          "width": "170px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "change": "const tipos = {\"Barras\": \"bar\", \"Barras horizontais\": \"hbar\", \"Linhas\": \"line\", \"Área\": \"area\"};\ngfVendas.chartType = tipos[selTipo.value] || 'bar';\n"
          },
          "items": [
            "Barras",
            "Barras horizontais",
            "Linhas",
            "Área"
          ]
        },
        {
          "id": "1f5daada-c9d4-4d18-a7df-5a40063971cc",
          "kind": "button",
          "name": "btnNovos",
          "text": "Novos dados",
          "x": 200,
          "y": 432,
          "width": "170px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "// Sorteia 6 valores novos e troca os dados do gráfico\nconst valores = [];\nfor (let i = 0; i < 6; i++) valores.push(Math.round(800 + Math.random() * 2200));\ngfVendas.setData(['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun'], valores);\nconst total = valores.reduce((a, b) => a + b, 0);\nlblInfo.textContent = 'Novos dados! Total do semestre: R$ ' + total.toLocaleString('pt-BR');\n"
          }
        },
        {
          "id": "c6222551-eca6-4855-b7dd-19d197fe2d63",
          "kind": "label",
          "name": "lblInfo",
          "text": "Toque numa barra para ver o valor.",
          "x": 20,
          "y": 488,
          "width": "350px",
          "height": "50px",
          "bg": "transparent",
          "color": "#334155",
          "events": {}
        }
      ],
      "events": {
