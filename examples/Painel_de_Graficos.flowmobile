        },
        {
          "id": "a546956d-f00b-45d4-8ceb-bb46443ce895",
          "kind": "label",
          "name": "lblValor",
          "text": "Novos pontos a cada segundo.",
          "x": 20,
          "y": 432,
          "width": "350px",
          "height": "36px",
          "bg": "transparent",
          "color": "#334155",
          "events": {}
        },
        {
          "id": "d21b2293-3809-439d-bf81-56151d1f3bca",
          "kind": "button",
          "name": "btnPausa",
          "text": "Pausar",
          "x": 20,
          "y": 478,
          "width": "170px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "window.__aoVivoPausa = !window.__aoVivoPausa;\nbtnPausa.textContent = window.__aoVivoPausa ? 'Continuar' : 'Pausar';\nlblValor.textContent = window.__aoVivoPausa ? 'Pausado' : 'Agora: ' + Math.round(window.__aoVivo ?? 50) + '%';\n"
          }
        },
        {
          "id": "23b5e92f-2fa3-43c7-a66b-1dfda75c3cab",
          "kind": "button",
          "name": "btnLimpar2",
          "text": "Limpar",
          "x": 200,
          "y": 478,
          "width": "170px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "gfLive.clear();\nwindow.__aoVivo = 50;\nlblValor.textContent = 'Gráfico limpo. Novos pontos a cada segundo.';\n"
          }
        },
        {
          "id": "119b1217-b7b6-4f4c-bb20-b7baf6a8e921",
          "kind": "timer",
          "name": "tmLive",
          "text": "Timer",
          "x": 20,
          "y": 600,
          "width": "90px",
          "height": "34px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "tick": "// A cada segundo acrescenta um ponto; o gráfico guarda só os últimos 20 (maxPoints)\nif (window.__aoVivoPausa) return;\nwindow.__aoVivo = Math.max(5, Math.min(95, (window.__aoVivo ?? 50) + (Math.random() - 0.5) * 18));\nconst agora = new Date();\nconst hora = String(agora.getMinutes()).padStart(2, '0') + ':' + String(agora.getSeconds()).padStart(2, '0');\ngfLive.addPoint(hora, Math.round(window.__aoVivo));\nlblValor.textContent = 'Agora: ' + Math.round(window.__aoVivo) + '%';\n"
          },
          "interval": 1000,
          "enabled": true
        }
      ],
      "events": {
        "onload": "",
        "onshow": ""
      }
    },
