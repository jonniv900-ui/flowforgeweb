        {
          "id": "7654ddf1-6211-419d-9407-c8c14039fbc7",
          "kind": "chart",
          "name": "gfDesp",
          "text": "",
          "x": 20,
          "y": 172,
          "width": "350px",
          "height": "240px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "select": "lblMsg.textContent = event.detail.label + ': R$ ' + event.detail.value.toLocaleString('pt-BR') + ' (' + Math.round(event.detail.value * 100 / Math.max(1, gfDesp.getData().series[0].values.reduce((a, b) => a + b, 0))) + '%)';"
          },
          "chartType": "doughnut",
          "chartTitle": "Despesas do mês",
          "chartLabels": "Moradia,Comida,Transporte,Lazer,Saúde",
          "values": "[1200,650,280,190,120]",
          "valuePrefix": "R$ ",
          "legend": true,
          "showValues": true,
          "animate": true
        },
        {
          "id": "21299489-8410-4279-9d5d-a667e8436aa8",
          "kind": "select",
          "name": "selCat",
          "text": "",
          "x": 20,
          "y": 422,
          "width": "170px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {},
          "items": [
            "Moradia",
            "Comida",
            "Transporte",
            "Lazer",
            "Saúde"
          ]
        },
        {
          "id": "59e5a745-1c53-40f3-87f7-619896a6dd23",
          "kind": "input",
          "name": "inpValor",
          "text": "Valor (ex.: 45,90)",
          "x": 200,
          "y": 422,
          "width": "170px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "keydown": "if(event.key==='Enter')btnAdd.click();"
          }
        },
        {
          "id": "0811c203-38df-4e25-b9cc-6a4ca2b02a4f",
          "kind": "button",
          "name": "btnAdd",
          "text": "Adicionar",
          "x": 20,
          "y": 476,
          "width": "170px",
          "height": "44px",
          "bg": "#2563eb",
          "color": "#ffffff",
          "events": {
            "click": "// lê os lançamentos salvos no aparelho (ou usa valores de exemplo)\nlet d = null;\ntry { d = JSON.parse(localStorage.getItem('graficos_despesas')); } catch (e) {}\nif (!d || typeof d !== 'object') d = { Moradia: 1200, Comida: 650, Transporte: 280, Lazer: 190, Saúde: 120 };\n// aceita 45,90 / 45.90 / R$ 1.200,50\nlet txt = inpValor.value.replace(/R\\$|\\s/g, '');\nif (txt.includes(',')) txt = txt.replace(/\\./g, '').replace(',', '.');\nconst v = Number(txt);\nif (!txt || !isFinite(v) || v <= 0 || v > 1000000) {\n  lblMsg.textContent = 'Digite um valor válido. Exemplo: 45,90';\n  return;\n}\nd[selCat.value] = Math.round(((d[selCat.value] || 0) + v) * 100) / 100;\ntry { localStorage.setItem('graficos_despesas', JSON.stringify(d)); } catch (e) {}\ninpValor.value = '';\nlblMsg.textContent = 'Adicionado em ' + selCat.value + ': R$ ' + v.toLocaleString('pt-BR');\nconst nomes = Object.keys(d);\ngfDesp.setData(nomes, nomes.map(n => d[n]));\nconst total = nomes.reduce((a, n) => a + d[n], 0);\nlblTotal.textContent = 'Total: R$ ' + total.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n"
          }
        },
        {
          "id": "2144dbdd-c9ac-415a-ac31-bcca7c6b9c11",
          "kind": "button",
          "name": "btnApagar",
          "text": "Apagar tudo",
          "x": 200,
          "y": 476,
          "width": "170px",
          "height": "44px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "const d = {};\ntry { localStorage.setItem('graficos_despesas', JSON.stringify(d)); } catch (e) {}\ngfDesp.clear();\nlblTotal.textContent = 'Total: R$ 0,00';\nlblMsg.textContent = 'Lançamentos apagados. Adicione novos acima.';\n"
          }
        },
        {
          "id": "93a236c3-816e-47fb-89a8-8b76c721ae89",
          "kind": "label",
          "name": "lblTotal",
          "text": "",
          "x": 20,
          "y": 530,
          "width": "350px",
          "height": "30px",
          "bg": "transparent",
          "color": "#0f172a",
          "events": {}
        },
        {
          "id": "0de557b8-1083-4370-8759-7deac054f1b6",
          "kind": "label",
          "name": "lblMsg",
          "text": "Toque numa fatia para ver o valor.",
          "x": 20,
          "y": 564,
          "width": "350px",
          "height": "50px",
          "bg": "transparent",
          "color": "#64748b",
          "events": {}
        }
      ],
      "events": {
        "onload": "",
        "onshow": "// lê os lançamentos salvos no aparelho (ou usa valores de exemplo)\nlet d = null;\ntry { d = JSON.parse(localStorage.getItem('graficos_despesas')); } catch (e) {}\nif (!d || typeof d !== 'object') d = { Moradia: 1200, Comida: 650, Transporte: 280, Lazer: 190, Saúde: 120 };\nconst nomes = Object.keys(d);\ngfDesp.setData(nomes, nomes.map(n => d[n]));\nconst total = nomes.reduce((a, n) => a + d[n], 0);\nlblTotal.textContent = 'Total: R$ ' + total.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n"
      }
