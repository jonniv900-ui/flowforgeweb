          "y": 244,
          "width": "168px",
          "height": "42px",
          "bg": "#dc2626",
          "color": "#ffffff",
          "events": {
            "click": "var $=function(i){return document.getElementById(i)};if(!window.ffDemo){window.ffDemo={n:0};}$('dbOut').textContent='Vai falhar…';funcaoQueNaoExiste();"
          }
        },
        {
          "id": "99ced1a6-386f-41d7-a198-99803026ba5e",
          "kind": "button",
          "name": "dbPromise",
          "text": "Promise rejeitada",
          "x": 205,
          "y": 244,
          "width": "168px",
          "height": "42px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "var $=function(i){return document.getElementById(i)};if(!window.ffDemo){window.ffDemo={n:0};}Promise.reject(new Error('Falha assíncrona de exemplo'));$('dbOut').textContent='Promise rejeitada enviada';"
          }
        },
        {
          "id": "cd43826a-257a-45ce-b51a-974e3e8b372d",
          "kind": "button",
          "name": "dbNet",
          "text": "Requisição (fetch)",
          "x": 20,
          "y": 296,
          "width": "168px",
          "height": "42px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "var $=function(i){return document.getElementById(i)};if(!window.ffDemo){window.ffDemo={n:0};}$('dbOut').textContent='Buscando…';fetch('dados-que-nao-existem.json').then(function(r){$('dbOut').textContent='Status '+r.status}).catch(function(e){$('dbOut').textContent='Falhou: '+e.message});"
          }
        },
        {
          "id": "38bc6288-8e6e-4640-9e12-37393f648b22",
          "kind": "button",
          "name": "dbVar",
          "text": "Criar variáveis",
