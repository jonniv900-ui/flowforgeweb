        {
          "id": "cd989b50-bca0-47ff-aed0-94aaf6c5d5ba",
          "kind": "button",
          "name": "dbLog",
          "text": "console.log",
          "x": 20,
          "y": 192,
          "width": "168px",
          "height": "42px",
          "bg": "#2563eb",
          "color": "#ffffff",
          "events": {
            "click": "var $=function(i){return document.getElementById(i)};if(!window.ffDemo){window.ffDemo={n:0};}window.ffDemo.n++;console.log('Clique número',window.ffDemo.n,{ok:true,lista:[1,2,3]});$('dbOut').textContent='Registrado no Console (variável ffDemo.n = '+window.ffDemo.n+')';"
          }
        },
        {
          "id": "502e517f-1c24-4120-81fb-9cc037ca758b",
          "kind": "button",
          "name": "dbWarn",
          "text": "console.warn",
          "x": 205,
          "y": 192,
          "width": "168px",
          "height": "42px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "var $=function(i){return document.getElementById(i)};if(!window.ffDemo){window.ffDemo={n:0};}console.warn('Atenção: isto é um aviso');$('dbOut').textContent='Aviso enviado ao Console';"
          }
        },
        {
          "id": "abddac56-3717-4a76-a4d1-0a978f6cdf05",
          "kind": "button",
