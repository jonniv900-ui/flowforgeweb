          "width": "168px",
          "height": "42px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "click": "var $=function(i){return document.getElementById(i)};if(!window.ffDemo){window.ffDemo={n:0};}window.usuario={nome:'Ana',nivel:3};window.pontos=(window.pontos||0)+10;window.ativo=true;$('dbOut').textContent='Veja a aba Variáveis (pontos = '+window.pontos+')';"
          }
        },
