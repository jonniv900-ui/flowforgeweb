        {
          "id": "bca1e884-03d2-4aa8-811e-787468bd3944",
          "kind": "label",
          "name": "bHint",
          "text": "Teclado: ← → mover, ↑ girar, ↓ descer, Espaço queda, P pausa. Toque no tabuleiro: arraste para mover, toque para girar, deslize para baixo para a queda direta. A peça tracejada mostra onde ela vai parar.",
          "x": 20,
