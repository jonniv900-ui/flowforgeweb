          "events": {
            "click": "var $=function(i){return document.getElementById(i)};var vis=function(i,on){var b=$(i),w=b.closest('.ff-component')||b;w.style.display=on?'':'none'};if(!window.ffQuiz){var G=window.ffQuiz={Q:[{\"q\": \"Qual é o maior planeta do Sistema Solar?\", \"o\": [\"Marte\", \"Júpiter\", \"Saturno\", \"Terra\"], \"a\": 1}, {\"q\": \"Quantos estados tem o Brasil (sem contar o Distrito Federal)?\", \"o\": [\"26\", \"27\", \"25\", \"24\"], \"a\": 0}, {\"q\": \"Qual linguagem roda nativamente nos navegadores?\", \"o\": [\"Python\", \"C#\", \"JavaScript\", \"Java\"], \"a\": 2}, {\"q\": \"Qual é o resultado de 7 × 8?\", \"o\": [\"54\", \"56\", \"58\", \"64\"], \"a\": 1}, {\"q\": \"Quem pintou a Mona Lisa?\", \"o\": [\"Michelangelo\", \"Van Gogh\", \"Leonardo da Vinci\", \"Picasso\"], \"a\": 2}, {\"q\": \"Qual elemento químico tem símbolo O?\", \"o\": [\"Ouro\", \"Oxigênio\", \"Ósmio\", \"Prata\"], \"a\": 1}, {\"q\": \"Em que continente fica o Egito?\", \"o\": [\"Ásia\", \"Europa\", \"África\", \"Oceania\"], \"a\": 2}, {\"q\": \"Qual é a capital da Argentina?\", \"o\": [\"Santiago\", \"Montevidéu\", \"Lima\", \"Buenos Aires\"], \"a\": 3}],i:0,score:0,lock:false,order:[]};G.best=function(){try{return Number(localStorage.getItem('ffQuizBest')||0)}catch(e){return 0}};G.bar=function(p){var el=$('quizBar');el=el.classList.contains('ff-progress')?el:(el.querySelector('.ff-progress')||el);var i=el.querySelector('i');if(i)i.style.setProperty('width',p+'%');el.setAttribute('aria-valuenow',p);var s=el.querySelector('span');if(s)s.textContent=Math.round(p)+'%'};G.show=function(){var q=G.Q[G.order[G.i]];$('quizQuestion').textContent=(G.i+1)+'/'+G.Q.length+' — '+q.q;for(var k=0;k<4;k++){var b=$('quizOpt'+k);b.textContent=q.o[k];b.style.background='#ffffff';b.style.color='#222222';b.disabled=false}vis('quizNext',false);$('quizScore').textContent='Acertos: '+G.score;G.bar(G.i/G.Q.length*100);G.lock=false};G.start=function(){G.i=0;G.score=0;G.order=G.Q.map(function(_,k){return k}).sort(function(){return Math.random()-.5});vis('quizRestart',false);G.show()};G.pick=function(k){if(G.lock)return;G.lock=true;var q=G.Q[G.order[G.i]],ok=k===q.a;if(ok)G.score++;Sons.play(ok?'coin':'error');for(var j=0;j<4;j++){var b=$('quizOpt'+j);b.disabled=true;if(j===q.a){b.style.background='#16a34a';b.style.color='#ffffff'}else if(j===k){b.style.background='#dc2626';b.style.color='#ffffff'}}$('quizScore').textContent='Acertos: '+G.score+(ok?' — Correto!':' — Errou');G.bar((G.i+1)/G.Q.length*100);if(G.i+1<G.Q.length){vis('quizNext',true);}else{G.end()}};G.end=function(){var n=G.score,t=G.Q.length,b=G.best();setTimeout(function(){Sons.play(n===t?'win':n>=t*0.6?'powerup':'lose')},450);if(n>b){try{localStorage.setItem('ffQuizBest',String(n))}catch(e){}b=n}$('quizQuestion').textContent='Fim do quiz! Você acertou '+n+' de '+t+(n===t?' — Perfeito!':n>=t*0.6?' — Muito bem!':' — Tente de novo!')+' (Recorde: '+b+')';vis('quizRestart',true);vis('quizNext',false)};G.next=function(){G.i++;G.show()};G.start()}window.ffQuiz.pick(0);"
          }
