      "id": "68957416-d726-4641-88eb-2365abcbda76",
      "name": "Principal",
      "items": [
        {
          "id": "5388d553-26db-4ab4-a742-6dd5b97a0630",
          "kind": "heading",
          "name": "gTitle",
          "text": "Controle de Gastos",
          "x": 20,
          "y": 68,
          "width": "353px",
          "height": "44px",
          "bg": "transparent",
          "color": "#222222",
          "events": {}
        },
        {
          "id": "70c4eb70-6616-4718-88af-385af3cd7882",
          "kind": "input",
          "name": "gDesc",
          "text": "Descrição (ex.: almoço)",
          "x": 20,
          "y": 120,
          "width": "353px",
          "height": "42px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "keydown": "var $=function(i){return document.getElementById(i)};if(!window.ffGastos){var G=window.ffGastos={items:[],K:'ffGastosV1'};try{G.items=JSON.parse(localStorage.getItem(G.K)||'[]')}catch(e){G.items=[]}\nG.brl=function(v){return 'R$ '+v.toFixed(2).replace('.',',').replace(/\\B(?=(\\d{3})+(?!\\d))/g,'.')};\nG.save=function(){try{localStorage.setItem(G.K,JSON.stringify(G.items))}catch(e){}};\nG.draw=function(){var tot=0,cat={};G.items.forEach(function(x){tot+=x.v;cat[x.c]=(cat[x.c]||0)+x.v});\n $('gTotal').textContent='Total: '+G.brl(tot);\n var keys=Object.keys(cat).sort(function(a,b){return cat[b]-cat[a]});\n $('gCats').textContent=keys.length?keys.map(function(k){return k+' '+Math.round(cat[k]/tot*100)+'%'}).join(' • '):'Nenhum gasto ainda.';\n $('gList').value=G.items.slice().reverse().map(function(x){return x.d+'  —  '+G.brl(x.v)+'  ('+x.c+')'}).join('\\n');\n $('gCount').textContent=G.items.length+(G.items.length===1?' lançamento':' lançamentos')};\nG.msg=function(t,bad){var m=$('gMsg');m.textContent=t;m.style.color=bad?'#dc2626':'#16a34a'};\nG.add=function(){var d=$('gDesc').value.trim(),raw=String($('gValor').value).replace(',','.'),v=parseFloat(raw);\n if(!d){G.msg('Descreva o gasto.',true);return}if(isNaN(v)||v<=0){G.msg('Informe um valor maior que zero.',true);return}\n G.items.push({d:d,v:Math.round(v*100)/100,c:$('gCat').value});G.save();$('gDesc').value='';$('gValor').value='';G.msg('Gasto adicionado ✔');G.draw();$('gDesc').focus()};\nG.undo=function(){if(!G.items.length){G.msg('Nada para desfazer.',true);return}var x=G.items.pop();G.save();G.msg('Removido: '+x.d);G.draw()};\nG.clear=function(){if(!G.items.length)return;if(confirm('Apagar todos os lançamentos?')){G.items=[];G.save();G.msg('Lista limpa.');G.draw()}};G.draw()}if(event.key==='Enter')window.ffGastos.add();"
          }
        },
        {
          "id": "1af89303-d02f-4898-b911-dc4a460787cc",
          "kind": "input",
          "name": "gValor",
          "text": "Valor (R$)",
          "x": 20,
          "y": 170,
          "width": "168px",
          "height": "42px",
          "bg": "#ffffff",
          "color": "#222222",
          "events": {
            "keydown": "var $=function(i){return document.getElementById(i)};if(!window.ffGastos){var G=window.ffGastos={items:[],K:'ffGastosV1'};try{G.items=JSON.parse(localStorage.getItem(G.K)||'[]')}catch(e){G.items=[]}\nG.brl=function(v){return 'R$ '+v.toFixed(2).replace('.',',').replace(/\\B(?=(\\d{3})+(?!\\d))/g,'.')};\nG.save=function(){try{localStorage.setItem(G.K,JSON.stringify(G.items))}catch(e){}};\nG.draw=function(){var tot=0,cat={};G.items.forEach(function(x){tot+=x.v;cat[x.c]=(cat[x.c]||0)+x.v});\n $('gTotal').textContent='Total: '+G.brl(tot);\n var keys=Object.keys(cat).sort(function(a,b){return cat[b]-cat[a]});\n $('gCats').textContent=keys.length?keys.map(function(k){return k+' '+Math.round(cat[k]/tot*100)+'%'}).join(' • '):'Nenhum gasto ainda.';\n $('gList').value=G.items.slice().reverse().map(function(x){return x.d+'  —  '+G.brl(x.v)+'  ('+x.c+')'}).join('\\n');\n $('gCount').textContent=G.items.length+(G.items.length===1?' lançamento':' lançamentos')};\nG.msg=function(t,bad){var m=$('gMsg');m.textContent=t;m.style.color=bad?'#dc2626':'#16a34a'};\nG.add=function(){var d=$('gDesc').value.trim(),raw=String($('gValor').value).replace(',','.'),v=parseFloat(raw);\n if(!d){G.msg('Descreva o gasto.',true);return}if(isNaN(v)||v<=0){G.msg('Informe um valor maior que zero.',true);return}\n G.items.push({d:d,v:Math.round(v*100)/100,c:$('gCat').value});G.save();$('gDesc').value='';$('gValor').value='';G.msg('Gasto adicionado ✔');G.draw();$('gDesc').focus()};\nG.undo=function(){if(!G.items.length){G.msg('Nada para desfazer.',true);return}var x=G.items.pop();G.save();G.msg('Removido: '+x.d);G.draw()};\nG.clear=function(){if(!G.items.length)return;if(confirm('Apagar todos os lançamentos?')){G.items=[];G.save();G.msg('Lista limpa.');G.draw()}};G.draw()}if(event.key==='Enter')window.ffGastos.add();"
          }
        },
